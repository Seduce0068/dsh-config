[user]
	email = <your-email>
	name = <your-name>
[credential "https://github.com"]
	helper = 
	helper = !${HOME}/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !${HOME}/.local/bin/gh auth git-credential
[core]
	excludesFile = ${HOME}/.config/git/ignore

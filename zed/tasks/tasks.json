// Zed グローバルタスク — `ctrl-alt-t` またはコマンドパレットの "task: spawn" で選択。
// プロジェクト固有タスクは <プロジェクト>/.zed/tasks.json に置く。
// 変数: $ZED_FILE, $ZED_DIRNAME, $ZED_RELATIVE_FILE, $ZED_WORKTREE_ROOT など。
[
  {
    "label": "Git: status",
    "command": "git",
    "args": ["status", "--short", "--branch"]
  },
  {
    "label": "Git: diff",
    "command": "git",
    "args": ["diff"]
  },
  {
    "label": "Git: log (graph, 20)",
    "command": "git",
    "args": ["log", "--oneline", "--graph", "--decorate", "-20"]
  },
  {
    "label": "Git: fetch --all --prune",
    "command": "git",
    "args": ["fetch", "--all", "--prune"]
  },
  {
    "label": "npm: install",
    "command": "npm",
    "args": ["install"]
  },
  {
    "label": "npm: test",
    "command": "npm",
    "args": ["test"]
  },
  {
    "label": "pnpm: install",
    "command": "pnpm",
    "args": ["install"]
  },
  {
    "label": "pnpm: test",
    "command": "pnpm",
    "args": ["test"]
  },
  {
    "label": "pnpm: build",
    "command": "pnpm",
    "args": ["run", "build"]
  },
  {
    "label": "cargo: build",
    "command": "cargo",
    "args": ["build"]
  },
  {
    "label": "cargo: test",
    "command": "cargo",
    "args": ["test"]
  },
  {
    "label": "cargo: clippy (all targets)",
    "command": "cargo",
    "args": ["clippy", "--all-targets"]
  },
  {
    "label": "cargo: fmt (write)",
    "command": "cargo",
    "args": ["fmt"]
  },
  {
    "label": "Python: pytest",
    "command": "python3",
    "args": ["-m", "pytest", "-q"]
  },
  {
    "label": "Python: ruff check",
    "command": "python3",
    "args": ["-m", "ruff", "check", "."]
  },
  {
    "label": "Markdown: markdownlint (workspace)",
    "command": "markdownlint-cli2",
    "args": ["**/*.md", "!**/node_modules/**"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Markdown: markdownlint --fix (workspace)",
    "command": "markdownlint-cli2",
    "args": ["--fix", "**/*.md", "!**/node_modules/**"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Shell: shellcheck (current file)",
    "command": "shellcheck",
    "args": ["$ZED_FILE"],
    "save": "all"
  },
  {
    "label": "Shell: shfmt -w (current file)",
    "command": "shfmt",
    "args": ["-w", "$ZED_FILE"],
    "save": "all"
  },
  {
    "label": "DSH: dsh-web service status",
    "command": "systemctl",
    "args": ["--user", "status", "dsh-web", "--no-pager"]
  },
  {
    "label": "Zed: tail log (50)",
    "command": "bash",
    "args": ["-lc", "tail -n 50 ~/.local/share/zed/logs/Zed.log"]
  },
  {
    "label": "Zed: validate settings",
    "command": "bash",
    "args": ["-lc", "python3 - <<'PY'\nimport json,re,sys\np='<home>/.config/zed/settings.json'\ns=open(p).read()\nout=[];i=0;n=len(s);instr=False;esc=False\nwhile i<n:\n    c=s[i]\n    if instr:\n        out.append(c)\n        if esc: esc=False\n        elif c=='\\\\': esc=True\n        elif c=='\"': instr=False\n        i+=1; continue\n    if c=='\"': instr=True; out.append(c); i+=1; continue\n    if c=='/' and i+1<n and s[i+1]=='/':\n        j=s.find('\\n',i); i=n if j<0 else j; continue\n    if c=='/' and i+1<n and s[i+1]=='*':\n        j=s.find('*/',i+2); i=n if j<0 else j+2; continue\n    out.append(c); i+=1\nt=''.join(out); t=re.sub(r',(\\s*[}\\]])',r'\\1',t)\ntry:\n    json.loads(t); print('OK: settings.json is valid JSONC')\nexcept Exception as e:\n    print('NG:',e); sys.exit(1)\nPY"]
  }
]

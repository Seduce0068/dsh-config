// Zed ユーザー設定 — koppe / Kubuntu 2026.04 (KDE Plasma 6, Wayland)
// 公式リファレンス: https://zed.dev/docs/configuring-zed
// 設定エディタ: コマンドパレット → "zed: open settings" (Ctrl+,)
{
  // ── 外観 ─────────────────────────────────────────────
  // 常時ダーク。ライトに戻すなら mode を "system" か "light" に。
  "cli_default_open_behavior": "existing_window",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "base_keymap": "VSCode",
  // ── 表示言語 (zed-i18n ビルド用) ─────────────────────
  // 公式 Zed は無視する。zed-i18n ビルドでは UI を日本語化する。
  "ui_locale": "ja-JP",

  // ── フォント（日本語対応）─────────────────────────────
  // UI は Zed 同梱フォント、日本語は Noto Sans CJK JP にフォールバック。
  "ui_font_family": ".ZedSans",
  "ui_font_fallbacks": ["Noto Sans CJK JP", "Noto Color Emoji"],
  "ui_font_size": 16,
  // バッファは Zed 同梱 Lilex (.ZedMono)。日本語は等幅 Noto にフォールバック。
  "buffer_font_family": ".ZedMono",
  "buffer_font_fallbacks": ["Noto Sans Mono CJK JP", "Noto Sans CJK JP", "Hack"],
  "buffer_font_size": 15,
  "buffer_line_height": "comfortable",

  // ── 保存・整形 ───────────────────────────────────────
  // フォーカスを外したときに自動保存し、保存時に整形する。
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  // 設定ファイル(JSONC)と Markdown は勝手に整形しない（下の languages で個別指定）。

  // ── エディタ ─────────────────────────────────────────
  "inlay_hints": {
    "enabled": true,
    "show_background": false
  },
  "cursor_blink": true,
  "cursor_shape": "bar",
  "show_whitespaces": "selection",
  "preferred_line_length": 100,
  "soft_wrap": "none",
  "relative_line_numbers": "disabled",
  "scroll_beyond_last_line": "one_page",
  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "folds": true
  },

  // ── Git ──────────────────────────────────────────────
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 400,
      "show_commit_summary": true
    },
    "blame": {
      "show_avatar": false
    }
  },

  // ── パネル配置（VSCode 風: 左=エクスプローラ/SCM、右=エージェント、下=ターミナル）
  "project_panel": {
    "dock": "left",
    "default_width": 300,
    "starts_open": true,
    "file_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "show_diagnostics": "all"
  },
  "git_panel": {
    "dock": "left",
    "default_width": 320,
    "tree_view": true,
    "file_icons": true
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 300,
    "file_icons": true
  },
  "agent": {
    "enabled": true,
    "dock": "right",
    "flexible": false,
    "default_width": 480,
    "tool_permissions": {
      "default": "confirm"
    }
  },

  // ── ターミナル ───────────────────────────────────────
  "terminal": {
    "dock": "bottom",
    "shell": "system",
    "font_family": ".ZedMono",
    "font_fallbacks": ["Noto Sans Mono CJK JP", "Hack"],
    "font_size": 13,
    "line_height": "standard",
    "default_height": 260,
    "working_directory": "current_project_directory",
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
        "conda_manager": "auto"
      }
    }
  },

  // ── タブ・ツールバー ─────────────────────────────────
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_close_button": "always",
    "show_diagnostics": "errors",
    "close_position": "right"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true
  },
  "status_bar": {
    "show_active_file": true
  },
  "search": {
    "search_on_type": true
  },
  // minimap は Zed 既定の never（VSCode 側もオフだったため）。
  "minimap": {
    "show": "never"
  },

  // ── ファイル走査 ─────────────────────────────────────
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/dist",
    "**/target",
    "**/.next",
    "**/.turbo",
    "**/.cache",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/coverage",
    "**/vendor"
  ],

  // ── ウィンドウ・プライバシー ─────────────────────────
  // 最後のタブを閉じてもウィンドウは閉じない（VSCode 風）。
  "when_closing_with_no_tabs": "keep_window_open",
  // 計測データは送らない。
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "restore_unsaved_buffers": true,
    // プロジェクト信頼は都度確認する（インポート時に true になっていた危険設定を戻す）。
    "trust_all_worktrees": false
  },

  // ── 拡張機能（起動時に自動インストール）─────────────
  "auto_install_extensions": {
    "html": true,
    "dockerfile": true,
    "docker-compose": true,
    "toml": true,
    "editorconfig": true,
    "xml": true,
    "env": true,
    "make": true,
    "just": true,
    "github-actions": true
  },

  // ── 外部エージェント（ACP）──────────────────────────
  // DSH = DeepSeek Harness を ACP 経由で Zed の Agent パネルから使う。
  // 事前に Zed 側で DSH の認証情報（$DSH_HOME）が使える状態であること。
  "agent_servers": {
    // API キーはラッパーが Web サービスと同じ env ファイルから読む（settings に秘密を書かない）。
    "DSH": {
      "type": "custom",
      "command": "/home/koppe/.local/bin/dsh-acp",
      "args": [],
      "env": {
        "DSH_HOME": "/home/koppe/.dsh-agentrouter"
      }
    }
  },

  // ── 言語別の上書き ───────────────────────────────────
  "languages": {
    // ドキュメントは手で整形しているので保存時整形しない。
    "Markdown": {
      "format_on_save": "off",
      "remove_trailing_whitespace_on_save": false,
      "soft_wrap": "editor_width"
    },
    // Zed 自身の設定 (settings/keymap/tasks.json) や tsconfig を壊さない。
    "JSONC": {
      "format_on_save": "off"
    }
  }
}
